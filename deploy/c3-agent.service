[Unit]
Description=C3 AirBridge vision agent (access through SSH tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=c3agent
Group=c3agent
WorkingDirectory=/opt/c3-airbridge
ExecStart=/opt/c3-airbridge/.venv/bin/python -m airbridge.agent --config /etc/c3-airbridge/agent.json --port 8871
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/c3-airbridge/.local

[Install]
WantedBy=multi-user.target
